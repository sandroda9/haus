# DEMO: no verified property or identity data. Set SITE_MODE=production only when ready.
SITE_MODE=demo
# No fabricated canonical address; set valid URL before production
PUBLIC_SITE_URL=
# Set both to enable server-side transactional e-mail via Resend API.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional: strong shared secret for IP-hashing in rate limiting logs
RATE_LIMIT_SALT=
# Production: use an external persistent rate limiter at the edge / deployment platform.
