---
import BaseLayout from '../layouts/BaseLayout.astro';
import {documents} from '../data/documents';
import Icon from '../components/ui/Icon.astro';
---
<BaseLayout title="Unterlagen" description="Verkaufsunterlagen, Grundrisse und technische Nachweise: freigegebene Dokumente herunterladen oder fehlende Unterlagen anfragen.">
 <div class="shell page-intro"><span class="eyebrow">DOKUMENTATION / 06</span><h1>Alle Unterlagen. <em>Gut organisiert.</em></h1><p>Dokumente sind nur dann direkt abrufbar, wenn sie ausdrücklich öffentlich freigegeben wurden. Vertrauliche Dateien werden nicht über öffentliche Links bereitgestellt.</p></div>
 <section class="section" style="padding-top:10px"><div class="shell"><div class="document-grid">{documents.map(doc=><article class="document-card"><Icon name={doc.access==='public'&&doc.approved?'file':'lock'} size={29}/><span class="document-status">{doc.access==='public'&&doc.approved?'ÖFFENTLICH FREIGEGEBEN':'AUF ANFRAGE'} · {doc.fileType}</span><h2>{doc.title}</h2><p>{doc.description}</p>{doc.access==='public'&&doc.approved&&doc.path ? <a class="text-link" href={doc.path} download>Herunterladen <Icon name="download" size={18}/></a> : <a class="text-link" href={`/kontakt?anliegen=${doc.id==='expose'?'expose':'frage'}&dokument=${encodeURIComponent(doc.id)}`}>Unterlage anfragen <Icon name="arrow-up-right" size={18}/></a>}</article>)}</div><p class="disclosure" style="margin-top:27px"><Icon name="info" size={17}/> Dokumente mit Freigabestatus «auf Anfrage» liegen nicht im öffentlichen Download-Verzeichnis.</p></div></section>
</BaseLayout>
