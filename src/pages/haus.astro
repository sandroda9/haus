---
import BaseLayout from '../layouts/BaseLayout.astro';
import {property} from '../data/property';
import {media} from '../data/media';
import {renovations} from '../data/renovations';
import {price,area,number} from '../lib/format';
import Icon from '../components/ui/Icon.astro';
const hero=media.find(item=>item.id===property.heroMediaId);
const editorialSections=property.sections.map((section,index)=>({...section,index,image:media.find(m=>m.id===section.mediaId)}));
const values=[
 ['Objekttyp',property.type],['Verkaufspreis',property.priceOnRequest?'Auf Anfrage':price(property.price,property.currency)],
 ['Wohnfläche',area(property.livingArea)],['Grundstücksfläche',area(property.plotArea)],['Zimmer',number(property.rooms)],
 ['Schlafzimmer',number(property.bedrooms)],['Badezimmer',number(property.bathrooms)],['Geschosse',number(property.floors)],
 ['Parkplätze',number(property.parking)],['Baujahr',number(property.yearBuilt)],['Zustand',property.condition],['Heizung',property.heating],
 ['Energieangaben',property.energy],['Verfügbarkeit',property.availability],
 ['Verkaufsstatus',property.status==='available'?'Verfügbar':property.status==='reserved'?'Reserviert':property.status==='sold'?'Verkauft':null],
 ['Standort',property.municipality]
].filter(([,v])=>v);
---
<BaseLayout title="Das Haus" description="Architektur, Raumkonzepte, Ausstattung und alle verfügbaren Objektdetails im digitalen Exposé.">
 <div class="shell page-intro"><span class="eyebrow">DAS HAUS / 01</span><h1>Ein Haus. <em>Viele Möglichkeiten.</em></h1><p class="lead">Ein sorgfältiger Blick auf Architektur, Gestaltung und funktionale Qualitäten. Dieses Beispiel wartet auf geprüfte Objektdaten.</p></div>
 <div class="shell"><img class="page-hero-image" src={hero?.src} srcset={hero?.srcSet} sizes={hero?.sizes??"100vw"} width={hero?.width??1600} height={hero?.height??1050} alt={hero?.alt??"Architekturdarstellung"} loading="eager"/><p class="disclosure"><Icon name="info" size={17}/> Digitale Konzeptdarstellung. Kein Nachweis für bauliche Eigenschaften.</p></div>
 <section class="section"><div class="shell"><span class="eyebrow">DIE IMMOBILIE</span><h2>Was dieses Haus ausmacht.</h2><div class="inner-reading">{property.description.map(p=><p>{p}</p>)}</div>
 {values.length > 0 ? <div class="property-stats" style="margin-top:35px">{values.map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</div> : <div class="editorial-note"><strong>Objektdaten folgen.</strong><p style="margin:8px 0 0">Preis, Flächen, Zimmer und technische Angaben werden ausschliesslich nach Prüfung ergänzt. Bis dahin zeigt diese Seite bewusst keine ausgedachten Immobilienkennzahlen.</p></div>}</div></section>
 <section class="section section-muted"><div class="shell"><div class="section-head-inline"><div><span class="eyebrow">RAUM & ATMOSPHÄRE</span><h2>Gedanken über <em>das Wohnen.</em></h2></div></div><div class="editorial-grid">{editorialSections.map(s=><article class="editorial-section">{s.image&&<img src={s.image.src} width={s.image.width} height={s.image.height} alt={s.image.alt} loading="lazy"/>}<div><span class="eyebrow">0{s.index+1} / KONZEPTANSICHT</span><h2>{s.title}</h2><p>{s.text}</p><a class="text-link" href="/galerie">Weitere Ansichten <Icon name="arrow-right" size={18}/></a></div></article>)}</div></div></section>
 <section class="section"><div class="shell"><div class="two-col-text"><div><span class="eyebrow">AUSSTATTUNG & TECHNIK</span><h2>Präzise Angaben. <em>Ohne Annahmen.</em></h2><p>Informationen zu Küche, Gebäudetechnik, Heizung, Materialisierung und Energie werden ergänzt, sobald deren Richtigkeit nachgewiesen ist.</p></div><div>{property.technicalDetails.length ? <dl>{property.technicalDetails.filter(x=>x.value!==null).map(d=><div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:12px 0"><dt>{d.label}</dt><dd style="margin:0;font-weight:650">{d.value}{d.suffix}</dd></div>)}</dl>:<div class="editorial-note">Technische Informationen sind für dieses Musterobjekt noch nicht freigegeben.</div>}{renovations.length>0&&<div><h3>Renovationshistorie</h3>{renovations.map(r=><p><strong>{r.year}: {r.title}</strong> — {r.description}</p>)}</div>}</div></div></div></section>
 <section class="quiet-cta"><div class="shell"><div><span class="eyebrow">NÄCHSTER SCHRITT</span><h2>Mehr erfahren?</h2><p>Stellen Sie Ihre Fragen oder fordern Sie die verfügbare Dokumentation an.</p></div><a href="/kontakt?anliegen=expose" class="btn btn-primary">Exposé anfragen <Icon name="arrow-up-right" size={18}/></a></div></section>
</BaseLayout>
