---
import BaseLayout from '../layouts/BaseLayout.astro';
import {floorplans} from '../data/floorplans';
import {media} from '../data/media';
import Icon from '../components/ui/Icon.astro';
import {withBase} from '../lib/paths';
---
<BaseLayout title="Grundrisse" description="Übersicht der Raumaufteilung mit vergrösserbaren Plänen. Aktuell ist ein ausdrücklich schematischer Demo-Grundriss hinterlegt.">
 <div class="shell page-intro"><span class="eyebrow">GRUNDRISSE / 03</span><h1>Jeder Quadratmeter <em>erzählt.</em></h1><p>Ein durchdachter Grundriss schafft Orientierung. Hier erhalten Sie künftig sämtliche geprüften Geschosspläne mit Raumbezeichnungen und Abmessungen.</p></div>
 <section class="section" style="padding-top:20px"><div class="shell"><div class="floorplan-stack">{floorplans.map(plan=>{const image=media.find(m=>m.id===plan.mediaId);return <article class="floorplan-page-card" style="margin-bottom:22px"><div class="floorplan-image"><a href={image?.src} data-pswp data-pswp-width={image?.width} data-pswp-height={image?.height} data-caption={plan.name+' – nicht massstäblicher Demo-Plan'} data-pswp-alt={image?.alt} aria-label={`${plan.name} vergrössern`}><img src={image?.src} width="1600" height="1050" alt={image?.alt} loading="lazy"/></a><span class="image-zoom"><Icon name="zoom" size={19}/></span></div><div><span class="eyebrow">GRUNDRISS · {plan.verified?'VERIFIZIERT':'DEMO'}</span><h2 style="font-size:clamp(1.8rem,3vw,2.6rem);margin:15px 0">{plan.name}</h2><p style="color:var(--sub)">{plan.description}</p>{plan.area!==null&&<p><strong>Geschossfläche:</strong> {plan.area} m²</p>}{plan.rooms.length>0&&<ul class="check-list">{plan.rooms.map(room=><li><Icon name="check" size={18}/>{room}</li>)}</ul>}<p class="disclosure"><Icon name="info" size={16}/> {plan.verified?'Freigegebener Plan':'Beispielzeichnung: Kein tatsächlicher Gebäudegrundriss.'}</p><a href={withBase('/unterlagen')} class="text-link">Pläne & Unterlagen <Icon name="arrow-right" size={18}/></a></div></article>})}</div></div></section>
 <section class="quiet-cta"><div class="shell"><div><span class="eyebrow">RAUM FÜR FRAGEN</span><h2>Sie möchten mehr wissen?</h2><p>Wir helfen Ihnen gerne mit verfügbaren Informationen weiter.</p></div><a class="btn btn-primary" href={withBase('/kontakt?anliegen=frage')}>Informationen anfragen <Icon name="arrow-right" size={18}/></a></div></section>
</BaseLayout>
<script>
 import {attachLightbox} from '../lib/gallery/lightbox';
 const root=document.querySelector<HTMLElement>('.floorplan-stack');
 if(root)attachLightbox(root,'a[data-pswp]');
</script>
