---
import {property} from '../../data/property';
import {area,price,number} from '../../lib/format';
import Icon from '../ui/Icon.astro';
const details=[
 ['Objektart',property.type],['Baujahr',property.yearBuilt?String(property.yearBuilt):null],
 ['Wohnfläche',area(property.livingArea)],['Grundstück',area(property.plotArea)],
 ['Zimmer',number(property.rooms)],['Geschosse',number(property.floors)],
 ['Preis',property.priceOnRequest?'Auf Anfrage':price(property.price,property.currency)]
].filter(([,value])=>value);
---
<section class="section section-muted" id="haus-beschreibung"><div class="shell description-grid">
 <div><span class="eyebrow">OBJEKTBESCHREIBUNG</span><h2>Ein Zuhause mit <em>Perspektive.</em></h2>{property.description.map(p=><p class="body-copy">{p}</p>)}<a class="text-link" href="/haus">Alle Hausdetails <Icon name="arrow-up-right" size={19}/></a></div>
 <div class="details-card"><div class="details-card-heading"><span class="eyebrow">AUF EINEN BLICK</span><h3>Wichtige Eckdaten</h3></div>{details.length ? <dl>{details.map(([key,value])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl> : <div class="details-empty"><Icon name="list" size={29}/><h4>Transparenz beginnt mit Fakten.</h4><p>Die verifizierten Objektkennzahlen werden hier zusammengefasst, sobald sie vorliegen. Keine Beispielwerte als Tatsachen.</p><a href="/kontakt?anliegen=frage" class="text-link">Informationen anfragen <Icon name="arrow-right" size={17}/></a></div>}</div>
 </div></section>
