---
import {media} from '../../data/media';
import {withBase} from '../../lib/paths';
import {mediaLabel} from '../../lib/gallery/filter';
import {isDemo} from '../../config/site';
import Icon from '../ui/Icon.astro';
const originals=media.filter(m=>m.published && m.kind==='photo' && m.isVerifiedOriginal);
const showcase=(originals.length ? originals : media.filter(m=>m.published && m.kind==='visualization')).slice(0,7);
const first=showcase[0];
---
<section class="section gallery-preview-section" id="galerie-vorschau"><div class="shell">
 <div class="section-head-inline gallery-heading"><div><span class="eyebrow">EINBLICKE</span><h2>Bilder sagen mehr<br/><em>als Worte.</em></h2></div><a class="btn btn-outline" href={withBase('/galerie')}>Alle Bilder entdecken <Icon name="arrow-up-right" size={17}/></a></div>
 <div class="preview-grid" data-preview>
  <div class="preview-lead"><div class="preview-image"><img data-preview-main src={first.src} srcset={first.srcSet} sizes={first.sizes??"(max-width: 700px) 100vw, 55vw"} width={first.width} height={first.height} alt={first.alt} loading="lazy"/><button type="button" class="preview-open" data-preview-open aria-label="Grossansicht öffnen"><Icon name="zoom" size={20}/></button><div class="preview-controls"><button data-prev type="button" class="round-control" aria-label="Vorheriges Bild"><Icon name="arrow-left" size={20}/></button><span class="preview-count" aria-live="polite" data-preview-count>01 / {String(showcase.length).padStart(2,'0')}</span><button data-next type="button" class="round-control" aria-label="Nächstes Bild"><Icon name="arrow-right" size={20}/></button></div></div><div class="image-meta"><span data-preview-title>{first.title}</span><small data-preview-label>{mediaLabel(first)}</small></div></div>
  <div class="preview-thumbnails">{showcase.slice(0,6).map((item,i)=><button type="button" class:list={['preview-thumb',{selected:i===0}]} data-preview-index={i} aria-label={`Bild ${i+1}: ${item.title}`} aria-pressed={i===0?'true':'false'}><img src={item.thumbnailSrc??item.src} srcset={item.srcSet} sizes={item.sizes??"(max-width: 700px) 33vw, 15vw"} width="1600" height="1050" alt="" loading="lazy"/></button>)}</div>
 </div>
 {isDemo && originals.length===0 && <p class="disclosure"><Icon name="info" size={15}/> Die dargestellten Motive sind digitale Demo-Visualisierungen, keine Fotos eines Verkaufsobjekts.</p>}
 <div id="preview-lightbox" class="lightbox-data" aria-hidden="true">{showcase.map(item=><a href={item.src} data-pswp data-pswp-width={item.width} data-pswp-height={item.height} data-caption={`${item.title} · ${mediaLabel(item)}`} data-pswp-alt={item.alt} tabindex="-1">{item.title}</a>)}</div>
 </div></section>
<script>
 import {media} from '../../data/media';
 import {mediaLabel} from '../../lib/gallery/filter';
 import {attachLightbox} from '../../lib/gallery/lightbox';
 const originals=media.filter(m=>m.published && m.kind==='photo' && m.isVerifiedOriginal);
 const items=(originals.length ? originals : media.filter(m=>m.published && m.kind==='visualization')).slice(0,7);
 const preview=document.querySelector<HTMLElement>('[data-preview]');
 const main=preview?.querySelector<HTMLImageElement>('[data-preview-main]');
 const counter=preview?.querySelector<HTMLElement>('[data-preview-count]');
 const title=preview?.querySelector<HTMLElement>('[data-preview-title]');
 const label=preview?.querySelector<HTMLElement>('[data-preview-label]');
 const thumbs=preview?.querySelectorAll<HTMLButtonElement>('[data-preview-index]');
 let current=0;
 const lightboxRoot=document.querySelector<HTMLElement>('#preview-lightbox');
 const lightbox=lightboxRoot?attachLightbox(lightboxRoot):null;
 function render(i:number){if(!items.length || !main)return;current=(i+items.length)%items.length; const item=items[current]; main.src=item.src;main.srcset=item.srcSet??'';main.alt=item.alt;if(counter)counter.textContent=`${String(current+1).padStart(2,'0')} / ${String(items.length).padStart(2,'0')}`; if(title)title.textContent=item.title;if(label)label.textContent=mediaLabel(item);thumbs?.forEach((b,n)=>{b.classList.toggle('selected',n===current);b.setAttribute('aria-pressed',String(n===current));});}
 preview?.querySelector('[data-prev]')?.addEventListener('click',()=>render(current-1));
 preview?.querySelector('[data-next]')?.addEventListener('click',()=>render(current+1));
 preview?.querySelector('[data-preview-open]')?.addEventListener('click',()=>lightbox?.loadAndOpen(current));
 thumbs?.forEach(b=>b.addEventListener('click',()=>render(Number(b.dataset.previewIndex))));
</script>
