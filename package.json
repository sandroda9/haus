    "test:all": "npm run check && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/node": "^9.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@lucide/astro": "^1.55.0",
    "photoswipe": "^5.4.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {"node": ">=20.11.0"}
}
