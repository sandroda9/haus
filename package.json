{
  "name": "atelier-immobilien-expose",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev",
    "build": "npm run check:content && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "tsx scripts/verify-publication.ts",
